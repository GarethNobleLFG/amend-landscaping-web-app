# Stage 1: Build the Go binary
FROM golang:1.23-alpine AS builder

WORKDIR /app

# Install necessary build tools if required
RUN apk add --no-cache git

# Download dependencies
COPY go.mod ./
RUN go mod download

# Copy source code
COPY . .

# Build the application binary for production
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/email-service ./cmd/api/main.go

# Stage 2: Run the binary in a minimal alpine image
FROM alpine:3.20

WORKDIR /app

# Install CA certificates for making secure outbound SMTP/HTTPS requests
RUN apk add --no-cache ca-certificates

# Copy the binary from the builder stage
COPY --from=builder /app/email-service /app/email-service

# Expose the production port
EXPOSE 8081

# Command to run the binary directly
CMD ["/app/email-service"]